{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gacha-manager",
  "main": "src/index.ts",
  "account_id": "YOUR_ACCOUNT_ID",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "YOUR_CUSTOM_DOMAIN", "custom_domain": true }],
  "vars": {
    "ALLOWED_ORIGINS": "*",
    "METADATA_FEEDS": "[]",
    "UPSTREAM_SYNC_ENABLED": "true",
    "UPSTREAM_LANGUAGES": "[\"en-us\",\"zh-cn\",\"zh-tw\",\"ja-jp\"]"
  },
  "secrets": {
    "required": ["METADATA_UPDATE_TOKEN", "UPSTREAM_SYNC_TOKEN"]
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gacha_meta",
      "database_id": "2ad55df3-3dbb-404b-9eae-a2543ea4dfe7",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 0.1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  }
}
