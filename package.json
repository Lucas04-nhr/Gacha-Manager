{
  "name": "gacha-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "/opt/homebrew/bin/wrangler dev",
    "types": "/opt/homebrew/bin/wrangler types",
    "check": "tsc --noEmit",
    "build": "/opt/homebrew/bin/wrangler deploy --dry-run --outdir dist",
    "test": "npm run build && node --test test/*.test.mjs",
    "deploy": "/opt/homebrew/bin/wrangler deploy",
    "db:migrate:local": "/opt/homebrew/bin/wrangler d1 migrations apply gacha_meta --local",
    "db:migrate:remote": "/opt/homebrew/bin/wrangler d1 migrations apply gacha_meta --remote",
    "metadata:sql": "node scripts/metadata-sql.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "miniflare": "^5.20261001.0-alpha",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  }
}
